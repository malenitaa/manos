{
  "name": "manos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy-wasm": "mkdir -p public/mediapipe && cp node_modules/@mediapipe/tasks-vision/wasm/* public/mediapipe/",
    "predev": "npm run copy-wasm",
    "prebuild": "npm run copy-wasm",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
